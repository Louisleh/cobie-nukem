# Large regenerable build artifacts stay out of history. Git LFS is reserved
# for irreplaceable Blender source and an explicitly selected generator mesh.

# Python environment for the collectible tools.
.venv/
__pycache__/

# Downloaded image-to-3D candidates. Provenance is recorded in the bakeoff
# capture report, but hosted outputs are not assumed to remain downloadable.
# Archive the winner before selection; the critical selected path is unignored
# so it cannot disappear silently from `git status`.
generated-meshes/*.glb
generated-meshes/*.ply
generated-meshes/*.obj
!generated-meshes/selected.glb

# Derived exports. Regenerate with scripts/build_figurine.py; authoritative
# source/export hashes live in exports/build_report.json.
exports/*.stl
exports/*.3mf

# The scripted prototype blend is fully regenerable from build_figurine.py.
#
# IMPORTANT: this exemption ends the moment the file contains manual sculpting.
# A hand-sculpted .blend is the source of truth per the PRD and is NOT
# reproducible from a script. Enable Git LFS and back up the supervised review
# blend before doing irreplaceable manual work. The critical reviewed path is
# unignored so it cannot disappear silently from `git status`.
blender/*.blend
blender/*.blend1
!blender/cobie_figurine_v1_reviewed.blend
!blender/cobie_figurine_v2_master.blend

# Personal photographs of Cobie. Identity input, not project source.
references/photos/*
!references/photos/.gitkeep

# Generated turnaround images; regenerate from references/turnaround-prompts.md.
concepts/turnaround/*.png
